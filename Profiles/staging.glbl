<?xml version="1.0" encoding="UTF-8"?>
<GlobalVariableEntities>
   <description>Staging mobile application configuration.</description>
   <name>staging</name>
   <tag></tag>
   <defaultProfile>false</defaultProfile>
   <GlobalVariableEntity>
      <description>Different staging Home account name or account number used by multi-account scenarios. Configure locally.</description>
      <initValue>''</initValue>
      <name>G_AlternateHomeAccount</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Alternate staging subscriber number used only by TC_BILL_ALREADY_PAID scenarios. Configure locally.</description>
      <initValue>'18765522241'</initValue>
      <name>G_AlternateMSISDN</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Alternate staging password used by TC_BILL_ALREADY_PAID when G_AlternateUseOTP is false. Configure locally.</description>
      <initValue>'abc123!'</initValue>
      <name>G_AlternatePassword</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Use OTP for the alternate TC_BILL_ALREADY_PAID login when true; use its alternate password when false.</description>
      <initValue>false</initValue>
      <name>G_AlternateUseOTP</name>
      <protected>false</protected>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Project-relative or absolute path to the staging APK, IPA, or iOS simulator app bundle.</description>
      <initValue>'Apps/mda-staging.apk'</initValue>
      <name>G_AppPath</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Staging Home account name or account number used to find and select the primary Home account. Configure locally.</description>
      <initValue>'302000031905'</initValue>
      <name>G_HomeAccount</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Staging subscriber number. Configure locally.</description>
      <initValue>'18768815395'</initValue>
      <name>G_MSISDN</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Staging password used when G_UseOTP is false.</description>
      <initValue>'abc123!A'</initValue>
      <name>G_Password</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Use OTP authentication when true; use password authentication when false.</description>
      <initValue>false</initValue>
      <name>G_UseOTP</name>
      <protected>false</protected>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description></description>
      <initValue>'18768815395'</initValue>
      <name>G_MSISDN2</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description></description>
      <initValue>'abc123!A'</initValue>
      <name>G_Password2</name>
      <protected>false</protected>
      <valueType>STRING</valueType>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description></description>
      <initValue>false</initValue>
      <name>G_UseOTP2</name>
      <protected>false</protected>
   </GlobalVariableEntity>
</GlobalVariableEntities>
